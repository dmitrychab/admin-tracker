<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>Admin Tracker PRO</title>
<style>
:root{--bg:#0D0D0D;--card:#161720;--cyan:#00F0FF;--pink:#FF007F;--green:#00FF66;--red:#FF2A4B;--muted:#8A93A2}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{background:#0D0D0D;color:#F5F7FA;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;min-height:100vh}
.app{max-width:460px;margin:0 auto;min-height:100vh;background:radial-gradient(circle at 15% 10%,rgba(0,240,255,.09),transparent 42%),radial-gradient(circle at 85% 30%,rgba(255,0,127,.09),transparent 45%),#0D0D0D;display:flex;flex-direction:column;padding-bottom:82px}
.hdr{display:flex;justify-content:space-between;align-items:center;padding:14px 18px 10px}
.title{font-size:19px;font-weight:800;color:var(--cyan);text-shadow:0 0 12px rgba(0,240,255,.4)}
.sub{font-size:12px;color:var(--muted);margin-top:2px}
.prof{width:42px;height:42px;border-radius:14px;background:#161A24;border:1px solid rgba(0,240,255,.45);color:var(--cyan);display:flex;align-items:center;justify-content:center;font-size:18px;cursor:pointer}
.scr{display:none;padding:0 16px 18px;flex-direction:column;gap:14px}
.scr.on{display:flex}
.prem{background:linear-gradient(135deg,rgba(255,0,127,.22),rgba(0,240,255,.15));border:1px solid rgba(255,0,127,.5);border-radius:20px;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;cursor:pointer}
.prem-l{display:flex;align-items:center;gap:12px}
.inf{width:38px;height:38px;border-radius:12px;background:rgba(0,0,0,.45);border:1px solid var(--pink);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;color:#fff}
.pro{font-size:11px;font-weight:700;padding:5px 10px;border-radius:10px;background:var(--pink);color:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card{background:var(--card);border-radius:20px;padding:14px;display:flex;flex-direction:column;justify-content:space-between;min-height:172px}
.c-cyan{border:1.5px solid rgba(0,240,255,.55);box-shadow:0 0 18px rgba(0,240,255,.14)}
.c-pink{border:1.5px solid rgba(255,0,127,.55);box-shadow:0 0 18px rgba(255,0,127,.14)}
.chead{font-size:13px;font-weight:700;display:flex;align-items:center;gap:6px}
.big{font-size:34px;font-weight:800;margin:8px 0 2px}
.sm{font-size:11px;color:var(--muted)}
.cbtns{display:flex;gap:8px;margin-top:10px}
.mbtn{flex:1;padding:9px 0;border-radius:12px;border:1px solid rgba(0,240,255,.45);background:rgba(0,240,255,.12);color:#fff;font-weight:700;font-size:14px;cursor:pointer}
.mbtn.p{background:rgba(0,240,255,.26)}
.pbtn{padding:9px 8px;border-radius:12px;border:1px solid rgba(255,0,127,.5);background:rgba(255,0,127,.18);color:#fff;font-size:12px;font-weight:600;cursor:pointer;text-align:center;margin-top:8px}
.rbtn{width:100%;padding:15px;border-radius:20px;background:rgba(0,255,102,.12);border:1.5px solid var(--green);box-shadow:0 0 18px rgba(0,255,102,.2);color:#fff;font-size:14px;font-weight:700;cursor:pointer}
.duty-w{display:flex;flex-direction:column;align-items:center;gap:8px;padding:6px 0}
.timer{font-size:21px;font-weight:700;letter-spacing:2px;color:var(--muted);font-variant-numeric:tabular-nums}
.timer.on{color:var(--green);text-shadow:0 0 10px rgba(0,255,102,.5)}
.dbtn{width:140px;height:140px;border-radius:50%;background:#12131A;border:3px solid var(--red);box-shadow:0 0 28px rgba(255,42,75,.4);color:var(--red);font-size:16px;font-weight:800;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}
.dbtn.on{border-color:var(--green);color:var(--green);box-shadow:0 0 32px rgba(0,255,102,.45)}
.panel{background:var(--card);border:1px solid rgba(255,255,255,.09);border-radius:20px;padding:16px;display:flex;flex-direction:column;gap:12px}
.stitle{font-size:15px;font-weight:700;color:var(--cyan)}
.fld label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px}
.fld input,.fld select{width:100%;padding:12px;border-radius:14px;background:#0B0C10;border:1px solid rgba(255,255,255,.16);color:#fff;font-size:14px;outline:none}
.prev{background:#08090C;border:1px dashed rgba(255,0,127,.55);border-radius:14px;padding:12px;font-size:13px;line-height:1.45;white-space:pre-line}
.cpbtn{width:100%;padding:14px;border-radius:14px;background:linear-gradient(90deg,var(--pink),#B800FF);border:none;color:#fff;font-weight:700;font-size:14px;cursor:pointer}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:8px 12px;border-radius:12px;background:rgba(255,0,127,.16);border:1px solid rgba(255,0,127,.45);color:#fff;font-size:12px;cursor:pointer}
.bars{display:flex;align-items:flex-end;justify-content:space-between;height:130px;padding-top:12px;gap:8px}
.bcol{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;height:100%;justify-content:flex-end}
.bfill{width:100%;max-width:24px;border-radius:7px 7px 3px 3px;background:linear-gradient(180deg,var(--cyan),rgba(0,240,255,.25))}
.srow{display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:13px}
.srow:last-child{border-bottom:none}
.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:460px;height:70px;background:rgba(14,14,18,.97);border-top:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-around;align-items:center;z-index:20}
.nbtn{display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:none;color:var(--muted);font-size:11px;font-weight:600;cursor:pointer}
.nbtn.on{color:var(--cyan)}
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-100px);background:#141820;border:1px solid var(--green);color:#fff;padding:10px 18px;border-radius:14px;font-size:13px;font-weight:600;z-index:100;transition:.25s}
.toast.on{transform:translateX(-50%) translateY(0)}
.mb{position:fixed;inset:0;background:rgba(0,0,0,.8);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}
.mb.on{display:flex}
.mc{width:100%;max-width:380px;background:#14151C;border:1px solid var(--cyan);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:12px}
</style>
</head>
<body>
<div class="app">
  <header class="hdr">
    <div><div class="title">Admin Tracker PRO</div><div class="sub" id="admH">Админ: Logan_Vercetti</div></div>
    <button class="prof" onclick="go('settings')">👤</button>
  </header>

  <main id="s-home" class="scr on">
    <div class="prem" onclick="oMod('Отключена реклама и открыта глубокая аналитика нарушений на 30 дней.','PREMIUM ∞ АКТИВЕН')">
      <div class="prem-l"><div class="inf">∞</div><div><div style="font-size:14px;font-weight:800">PREMIUM</div><div class="sm" style="color:#d6dce6">Без рекламы • Глубокая статистика</div></div></div>
      <div class="pro">PRO</div>
    </div>

    <div class="grid">
      <div class="card c-cyan">
        <div>
          <div class="chead" style="color:var(--cyan)">🛡 Репорты</div>
          <div class="big" id="repC">42</div>
          <div class="sm">Отвечено сегодня</div>
          <div class="sm" style="color:var(--cyan);margin-top:4px">В очереди: <span id="qC">3</span></div>
        </div>
        <div class="cbtns">
          <button class="mbtn" onclick="chg(-1)">-1</button>
          <button class="mbtn p" onclick="chg(1)">+1</button>
        </div>
      </div>

      <div class="card c-pink">
        <div>
          <div class="chead" style="color:var(--pink)">📄 Формы</div>
          <div class="sm" style="color:#fff;font-weight:600;margin-top:8px">Быстрый ответ</div>
          <div class="sm">За смену: <span id="frmC">7</span></div>
        </div>
        <div>
          <div class="pbtn" onclick="go('forms')">Написать наказание</div>
          <div class="pbtn" onclick="go('forms');tpl('warn')">Шаблоны</div>
        </div>
      </div>
    </div>

    <button class="rbtn" onclick="rep()">✅ Сгенерировать отчет за смену</button>

    <div class="duty-w">
      <div class="timer" id="tmr">00:00:00</div>
      <button class="dbtn" id="dbtn" onclick="duty()">
        <span id="dtxt">OFF DUTY</span>
        <span class="sm" id="dhnt">Нажмите для начала</span>
      </button>
    </div>
  </main>

  <section id="s-forms" class="scr">
    <div class="panel">
      <div class="stitle">Редактор форм и наказаний</div>
      <div class="chips">
        <button class="chip" onclick="tpl('warn')">Выдать варн</button>
        <button class="chip" onclick="tpl('unban')">Снять бан</button>
        <button class="chip" onclick="tpl('deny')">Отказ в жалобе</button>
      </div>
      <div class="fld"><label>Ник или ID нарушителя</label><input id="tnick" value="Dante_Moretti" oninput="upd()"></div>
      <div class="fld"><label>Пункт правил</label>
        <select id="rule" onchange="upd()">
          <option value="2.1 DM (Убийство без причины)">п. 2.1 DM</option>
          <option value="2.2 DB (Нанесение урона авто)">п. 2.2 DB</option>
          <option value="2.3 PG (PowerGaming)">п. 2.3 PG</option>
          <option value="3.1 MG (MetaGaming)">п. 3.1 MG</option>
          <option value="4.1 NonRP поведение">п. 4.1 NonRP</option>
          <option value="5.2 Уход от RP">п. 5.2 Уход от RP</option>
        </select>
      </div>
      <div class="fld"><label>Тип наказания</label>
        <select id="pun" onchange="upd()">
          <option value="Jail 60 min">Jail 60 min</option>
          <option value="Jail 120 min">Jail 120 min</option>
          <option value="Warn">Warn</option>
          <option value="Ban 3 дня">Ban 3 дня</option>
          <option value="Mute 30 min">Mute 30 min</option>
        </select>
      </div>
      <div class="fld"><label>Готовый текст</label><div class="prev" id="fprev"></div></div>
      <button class="cpbtn" onclick="cpFrm()">Скопировать в буфер обмена</button>
    </div>
  </section>

  <section id="s-stats" class="scr">
    <div class="panel"><div class="stitle">Репорты за неделю</div><div class="bars" id="chart"></div></div>
    <div class="panel">
      <div class="stitle">Эффективность</div>
      <div class="srow"><span>Средняя скорость ответа</span><span style="color:var(--green);font-weight:700">14 сек</span></div>
      <div class="srow"><span>Закрыто за неделю</span><span style="color:var(--cyan);font-weight:700">286 репортов</span></div>
    </div>
    <div class="panel">
      <div class="stitle" style="color:var(--pink)">Топ-3 нарушений</div>
      <div class="srow"><span>1. п. 2.1 DM</span><span style="color:var(--pink);font-weight:700">44%</span></div>
      <div class="srow"><span>2. п. 4.1 NonRP</span><span style="color:var(--cyan);font-weight:700">31%</span></div>
      <div class="srow"><span>3. п. 3.1 MG</span><span style="color:var(--green);font-weight:700">25%</span></div>
    </div>
  </section>

  <section id="s-settings" class="scr">
    <div class="panel">
      <div class="stitle">Профиль администратора</div>
      <div class="fld"><label>Ваш игровой никнейм</label><input id="anick" value="Logan_Vercetti"></div>
      <button class="cpbtn" onclick="svNick()">Сохранить ник</button>
      <button class="rbtn" style="padding:12px" onclick="rst()">Сбросить счетчики дня</button>
    </div>
  </section>

  <nav class="nav">
    <button class="nbtn on" data-t="home" onclick="go('home')"><span>🏠</span>Главная</button>
    <button class="nbtn" data-t="forms" onclick="go('forms')"><span>✏️</span>Формы</button>
    <button class="nbtn" data-t="stats" onclick="go('stats')"><span>📊</span>Статистика</button>
    <button class="nbtn" data-t="settings" onclick="go('settings')"><span>⚙️</span>Настройки</button>
  </nav>
</div>

<div class="toast" id="tst">Скопировано!</div>
<div class="mb" id="mod"><div class="mc"><div class="stitle" id="mt"></div><div class="prev" id="mbd"></div><div style="display:flex;gap:10px"><button class="cpbtn" onclick="cp(document.getElementById('mbd').textContent);cMod()">Скопировать</button><button class="mbtn" style="padding:0 14px" onclick="cMod()">Закрыть</button></div></div></div>

<script>
function gs(k,d){try{var v=localStorage.getItem(k);return v!==null?v:d}catch(e){return d}}
function ss(k,v){try{localStorage.setItem(k,v)}catch(e){}}
var S={r:+gs('at_r',42),q:3,f:+gs('at_f',7),n:gs('at_n','Logan_Vercetti'),on:0,ds:+gs('at_d',0),iv:null,lt:0};
function init(){
  document.getElementById('repC').textContent=S.r;
  document.getElementById('frmC').textContent=S.f;
  document.getElementById('anick').value=S.n;
  document.getElementById('admH').textContent='Админ: '+S.n;
  document.getElementById('tmr').textContent=ft(S.ds);
  upd();draw();
}
function go(t){
  document.querySelectorAll('.scr').forEach(function(e){e.classList.remove('on')});
  document.getElementById('s-'+t).classList.add('on');
  document.querySelectorAll('.nbtn').forEach(function(b){b.classList.toggle('on',b.dataset.t===t)});
}
function chg(d){
  S.r=Math.max(0,S.r+d);if(d>0&&S.q>0)S.q--;if(d<0)S.q++;
  ss('at_r',S.r);document.getElementById('repC').textContent=S.r;document.getElementById('qC').textContent=S.q;draw();
}
function ft(s){return[Math.floor(s/3600),Math.floor(s%3600/60),s%60].map(function(x){return String(x).padStart(2,'0')}).join(':')}
function duty(){
  var b=document.getElementById('dbtn'),t=document.getElementById('dtxt'),h=document.getElementById('dhnt'),tm=document.getElementById('tmr');
  S.on=!S.on;
  if(S.on){
    b.classList.add('on');tm.classList.add('on');t.textContent='ON DUTY';h.textContent='Смена активна';S.lt=Date.now();
    S.iv=setInterval(function(){var n=Date.now();S.ds+=Math.floor((n-S.lt)/1000);S.lt=n;ss('at_d',S.ds);tm.textContent=ft(S.ds)},1000);
    tst('Вы заступили на смену');
  }else{
    b.classList.remove('on');tm.classList.remove('on');t.textContent='OFF DUTY';h.textContent='Нажмите для начала';clearInterval(S.iv);
    tst('Смена: '+ft(S.ds));
  }
}
function upd(){
  var n=document.getElementById('tnick').value.trim()||'[Ник]';
  document.getElementById('fprev').textContent='Игрок '+n+' получил наказание в виде '+document.getElementById('pun').value+' за нарушение пункта '+document.getElementById('rule').value+'. Админ: '+S.n;
}
function tpl(type){
  var n=document.getElementById('tnick').value.trim()||'[Ник]';
  if(type==='warn'){document.getElementById('pun').value='Warn';upd()}
  else if(type==='unban'){document.getElementById('fprev').textContent='Аккаунт игрока '+n+' разблокирован по итогам пересмотра. Приятной игры! Админ: '+S.n}
  else{document.getElementById('fprev').textContent='В жалобе отказано: недостаточно доказательств нарушения со стороны '+n+'. Админ: '+S.n}
}
function cpFrm(){cp(document.getElementById('fprev').textContent);S.f++;ss('at_f',S.f);document.getElementById('frmC').textContent=S.f}
function rep(){
  oMod('📊 ОТЧЕТ ЗА СМЕНУ ('+new Date().toLocaleDateString('ru-RU')+')\n👤 Админ: '+S.n+'\n⏱ На дежурстве: '+ft(S.ds)+'\n🛡 Репортов: '+S.r+'\n📝 Форм: '+S.f,'Отчет за смену готов');
}
function oMod(b,t){document.getElementById('mt').textContent=t;document.getElementById('mbd').textContent=b;document.getElementById('mod').classList.add('on')}
function cMod(){document.getElementById('mod').classList.remove('on')}
function svNick(){var v=document.getElementById('anick').value.trim();if(!v)return;S.n=v;ss('at_n',v);document.getElementById('admH').textContent='Админ: '+v;upd();tst('Ник сохранен')}
function rst(){S.r=0;S.f=0;S.ds=0;ss('at_r',0);ss('at_f',0);ss('at_d',0);init();tst('Сброшено')}
function draw(){
  var d=[{d:'Пн',v:34},{d:'Вт',v:48},{d:'Ср',v:29},{d:'Чт',v:55},{d:'Пт',v:41},{d:'Сб',v:62},{d:'Вс',v:S.r}];
  var m=Math.max.apply(null,d.map(function(i){return i.v}).concat([1]));
  document.getElementById('chart').innerHTML=d.map(function(i){
    return '<div class="bcol"><div class="sm" style="color:#fff">'+i.v+'</div><div class="bfill" style="height:'+Math.max(12,Math.round(i.v/m*100))+'%"></div><div class="sm">'+i.d+'</div></div>';
  }).join('');
}
function cp(t){
  var fb=function(){var a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();try{document.execCommand('copy');tst('Скопировано!')}catch(e){}document.body.removeChild(a)};
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(function(){tst('Скопировано!')}).catch(fb);else fb();
}
function tst(m){var t=document.getElementById('tst');t.textContent=m;t.classList.add('on');setTimeout(function(){t.classList.remove('on')},2200)}
init();
</script>
</body>
</html>
